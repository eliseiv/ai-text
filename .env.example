# =============================================================================
# LOCAL DEV env template. Copy to `.env`.
# Placeholders / dev defaults only — NEVER commit a real secret (`.env` is gitignored).
# In prod use .env.prod.example and a secret manager, never a plaintext .env.
#
# This lists the CORE variables only. A new service adds ITS OWN variables (DomainSettings) —
# they do not mix with this list.
# =============================================================================

# --- Service / instance identity ---------------------------------------------
# Name of THIS service: OpenAPI title, `service` label in logs/metrics. Public.
SERVICE_NAME=docs-rag
# Optional human-readable OpenAPI title. Empty -> title = SERVICE_NAME.
SERVICE_TITLE=
# Application version: OpenAPI `version` + the `version` label of logs/metrics.
SERVICE_VERSION=0.1.0
# Instance domain. Prod: Traefik Host router + ACME. Also read by the app to build absolute URLs.
# Local dev: leave EMPTY -> relative URLs.
SERVICE_DOMAIN=
# docker-compose project name = instance prefix (image tags, Traefik router/service names).
# Empty -> `service`.
COMPOSE_PROJECT_NAME=
# ACME cert-resolver name of the shared Traefik. Consumed ONLY by docker-compose.prod.yml (the
# local stack has no Traefik) — listed here to keep this file's list of env NAMES complete.
TRAEFIK_CERTRESOLVER=le
ENVIRONMENT=dev
LOG_LEVEL=INFO
# /docs, /redoc, /openapi.json. MUST be false in prod.
DOCS_ENABLED=true

# --- Storage -----------------------------------------------------------------
# For docker-compose, point the host at the service names (postgres / redis):
#   DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/app
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app
REDIS_URL=redis://localhost:6379/0
# Postgres container bootstrap (docker-compose only) — dev placeholders, not prod secrets.
# All three MUST agree with DATABASE_URL above.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
# Connection pool per process. Keep (DB_POOL_SIZE + DB_MAX_OVERFLOW) * workers * replicas below
# Postgres max_connections.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# --- Auth / JWT (embedded RS256 issuer) --------------------------------------
# Generate a keypair for local dev:
#   openssl genrsa -out .secrets/jwt_private.pem 2048
#   openssl rsa -in .secrets/jwt_private.pem -pubout -out .secrets/jwt_public.pem
# Without a private key /v1/auth/* returns 503 (verification still works).
JWT_ISSUER=http://localhost:8000
JWT_AUDIENCE=service
JWT_KID=
# Keys by file path (preferred). *_PATH takes priority over the inline PEM below.
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
# Alternative inline PEM (\n-escaped, single line). SECRET — leave empty when using *_PATH.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Verify-only mode against an EXTERNAL issuer; leave empty for the embedded issuer.
JWT_JWKS_URL=
JWT_JWKS_CACHE_TTL=300
AUTH_ACCESS_TTL_SECONDS=3600
AUTH_REFRESH_TTL_SECONDS=2592000
AUTH_RATE_LIMIT_PER_IP=10
AUTH_JWKS_ENABLED=true

# --- Sign in with Apple ------------------------------------------------------
APPLE_OIDC_ISSUER=https://appleid.apple.com
APPLE_JWKS_URL=https://appleid.apple.com/auth/keys
# Expected `aud` = the app's bundle id. Empty -> falls back to APPSTORE_BUNDLE_ID.
# Both empty -> POST /v1/auth/apple returns 503.
APPLE_AUDIENCE=
# HS256 test-mode for hermetic tests. Prod is fail-closed (HS256 outside test-mode -> 401).
# NEVER enable in prod.
APPLE_TEST_MODE=false
# SECRET (test-only). Required when APPLE_TEST_MODE=true. Never set in prod.
APPLE_TEST_SECRET=

# --- Apple StoreKit ----------------------------------------------------------
APPSTORE_ENVIRONMENT=Sandbox
APPSTORE_BUNDLE_ID=
# Directory with the Apple root CA. Unset -> the verifier refuses transactions (422, fail-closed).
APPSTORE_ROOT_CERT_DIR=
# HS256 test verification. Prod is fail-closed; MUST be false in prod.
STOREKIT_TEST_MODE=false
# SECRET (test-only). Never set in prod.
STOREKIT_TEST_SECRET=

# --- Billing — common --------------------------------------------------------
# THE single product map and the ONLY source of the credit amount (BR-8) plus the per-product
# channel allowlist. A productId absent from here (or not allowed in the paying channel) is
# REJECTED: 0 credits, WARNING, alert PaymentRejected. There is NO fallback grant anywhere.
# `period` (ISO-8601: P1W / P1M / P1Y) is REQUIRED for a subscription sold via cloudpayments:
# the RU channel reports a payment, not an expiry, so access lasts exactly one period.
PRODUCTS={"week_6.99_nottrial":{"kind":"subscription","credits":100,"channels":["apple_storekit","adapty","cloudpayments"],"title":"Неделя","period":"P1W"},"yearly_49.99_nottrial":{"kind":"subscription","credits":800,"channels":["apple_storekit","adapty","cloudpayments"],"title":"Год","period":"P1Y"},"100_Tokens_9.99":{"kind":"tokens","credits":100,"channels":["apple_storekit","adapty","cloudpayments"],"title":"100 кредитов"},"250_Tokens_19.99":{"kind":"tokens","credits":250,"channels":["apple_storekit","adapty","cloudpayments"],"title":"250 кредитов"},"500_Tokens_34.99":{"kind":"tokens","credits":500,"channels":["apple_storekit","adapty","cloudpayments"],"title":"500 кредитов"},"1000_Tokens_59.99":{"kind":"tokens","credits":1000,"channels":["apple_storekit","adapty","cloudpayments"],"title":"1000 кредитов"}}
# Default credits for the ADMIN subscription grant only (POST /v1/admin/subscription/grant with
# `credits` omitted). NOT used by any payment channel.
SUBSCRIPTION_CREDITS_PER_PERIOD=1000
# Grant one lifetime trial generation without a subscription (BR-1).
TRIAL_ENABLED=true

# --- Billing — Adapty --------------------------------------------------------
# SECRET. Bearer for POST /v1/billing/adapty/webhook (constant-time compare), >= 32 bytes,
# per-instance. Empty -> the endpoint returns 500. The SAME value goes into the Adapty UI.
# Generate: openssl rand -hex 32
ADAPTY_WEBHOOK_SECRET=

# --- Billing — CloudPayments / broadapps (RU) --------------------------------
# Fixed aggregator API host for our OUTGOING calls (anti-SSRF), e.g. https://pay.broadapps.dev/api/v1
CLOUDPAYMENTS_API_BASE=
CLOUDPAYMENTS_APP_ID=
# SECRET. Bearer of OUR outgoing calls (checkout + verify). Channel activation gate:
# empty -> webhook 500, checkout 503.
CLOUDPAYMENTS_API_TOKEN=
# LEGACY, optional. No longer gates anything; only used for the `matched` observability field.
CLOUDPAYMENTS_WEBHOOK_TOKEN=
CLOUDPAYMENTS_PAID_STATUSES=succeeded
# Aggregator statuses meaning "refunded" (CSV). A refund callback is only a trigger: the
# refund is confirmed through verify, and only payments we credited are reversed.
CLOUDPAYMENTS_REFUNDED_STATUSES=refunded
CLOUDPAYMENTS_PAYMENT_FRESHNESS_HOURS=72
CLOUDPAYMENTS_WEBHOOK_RATE_LIMIT_PER_IP=120

# --- Generation & pricing ----------------------------------------------------
# `echo` = the built-in EchoProvider (works out of the box). A domain registers its own provider
# via DomainRegistry.generation_provider and names it here.
GENERATION_PROVIDER=echo
# Summaries of long topics make several model calls: keep this generous.
GENERATION_TIMEOUT_SECONDS=600
# Must hold a full answer/summary (idempotent replay after a worker crash reads it back).
GENERATION_META_MAX_BYTES=262144
# Max concurrent pending/running generations per user. Exceeding -> 409 too_many_inflight.
# 0 disables the guard.
GENERATION_MAX_INFLIGHT_PER_USER=3
# flat | units | tokens | custom
# The domain registers its own pricing (ANSWER_CREDITS / SUMMARY_CREDITS below).
PRICING_MODE=flat
PRICING_FLAT_CREDITS=1
# PRICING_MODE=units: {"<kind>": rate, "<kind>:<model>": rate}
PRICING_UNITS={}
# PRICING_MODE=tokens: {"default":{"input":1,"output":4,"cache_read":0.1}}
PRICING_TOKEN_WEIGHTS={}
PRICING_TOKEN_DIVISOR=1000
# Anti-tamper ceiling on the price of ONE generation (BR-9).
PRICING_MAX_CREDITS_PER_GENERATION=100

# --- Admin -------------------------------------------------------------------
# SECRET. X-Admin-Token for /v1/admin/*. High-entropy (openssl rand -base64 32).
# Empty -> the admin API always returns 401.
ADMIN_API_SECRET=
# SECRET. Previous secret, valid during a rotation grace period. Empty outside rotation.
ADMIN_API_SECRET_PREV=
ADMIN_RATE_LIMIT_PER_MIN=10

# --- Gateway / limits --------------------------------------------------------
SIZE_LIMIT_BODY=524288
RATE_LIMIT_PER_USER=60
RATE_LIMIT_PER_IP=120
# POST /v1/generate, per user, per RATE_LIMIT_WINDOW_SECONDS.
RATE_LIMIT_GENERATION_PER_USER=20
# Sliding-window width of every Redis limiter. 60 => the caps above read as "per minute".
RATE_LIMIT_WINDOW_SECONDS=60
# Comma-separated IP/CIDR of trusted proxies. Empty -> X-Forwarded-For is IGNORED (socket peer is
# used) — the safe default for local dev. In PROD this MUST be the `web` network subnet.
TRUSTED_PROXY_IPS=
TRUSTED_PROXY_HOP_COUNT=1

# --- Observability -----------------------------------------------------------
# SECRET. If set, GET /metrics requires X-Scrape-Token == this value (otherwise 403).
METRICS_SCRAPE_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# =============================================================================
# DOMAIN — sources, AI summaries, Q&A with citations (DomainSettings)
# =============================================================================
# --- LLM: OpenAI (server-side only; the iOS app never holds a model key) --------
# openai | fake   (fake = deterministic offline model for local runs/tests)
LLM_PROVIDER=fake
# SECRET. Primary key and a backup key of a SECOND account (takes over on auth/quota errors).
OPENAI_API_KEY=
OPENAI_API_KEY_BACKUP=
# Optional gateway in front of the API. Empty -> https://api.openai.com/v1.
OPENAI_BASE_URL=
# Optional (the service runs on a foreign server — leave EMPTY). SECRET if set: comma-separated
# proxies tried in order on connection errors, e.g. socks5://user:pass@host:1080
OPENAI_PROXY_URLS=
# Answers and summaries. Summaries may use a cheaper model (empty = OPENAI_MODEL).
OPENAI_MODEL=gpt-5.1
OPENAI_SUMMARY_MODEL=
# «Does the quote support the claim?» — a yes/no check, a small model is enough.
OPENAI_CHECK_MODEL=gpt-5-mini
# gpt-5*/o-series only: minimal | low | medium | high  (gpt-5.1 also: none)
OPENAI_REASONING_EFFORT=low
OPENAI_CHECK_REASONING_EFFORT=minimal
# Includes reasoning tokens.
OPENAI_MAX_OUTPUT_TOKENS=16000
OPENAI_TIMEOUT_SECONDS=180
OPENAI_MAX_RETRIES=2
# Second pass: does every quote actually support its claim? Unsupported claims are dropped.
CITATION_SUPPORT_CHECK=true

# --- Prices in credits (rationale: docs/pricing.md) ------------------------------
ANSWER_CREDITS=1
# Summary: base price while the topic fits one pass (SUMMARY_SINGLE_PASS_CHARS), plus this much
# for every extra part of SUMMARY_BATCH_CHARS. Max = 3 + 2 * (SUMMARY_MAX_BATCHES - 1) = 17.
SUMMARY_CREDITS=3
SUMMARY_CREDITS_PER_EXTRA_PART=2

# --- Context budgets -----------------------------------------------------------
ANSWER_CONTEXT_CHARS=100000
ANSWER_HISTORY_TURNS=6
QUESTION_MAX_CHARS=2000
SUMMARY_SINGLE_PASS_CHARS=150000
SUMMARY_BATCH_CHARS=120000
SUMMARY_MAX_BATCHES=8
CHUNK_TARGET_CHARS=1500

# --- Import limits (served as is by GET /v1/limits) ----------------------------
PDF_MAX_BYTES=31457280
PDF_MAX_PAGES=300
PDF_MIN_CHARS_PER_PAGE=20
PDF_MIN_TEXT_PAGE_RATIO=0.3
TEXT_MIN_CHARS=50
TEXT_MAX_CHARS=300000
WEB_MAX_BYTES=5242880
WEB_TIMEOUT_SECONDS=15
WEB_MAX_REDIRECTS=5
TOPIC_MAX_SOURCES=20
USER_MAX_TOPICS=100
USER_STORAGE_MAX_BYTES=1073741824

# --- Files -----------------------------------------------------------------------
# docker-compose overrides this with the shared volume /data/files.
FILES_DIR=./.data/files
# SECRET. HMAC key of temporary file links (openssl rand -hex 32). Empty -> links answer 503.
FILES_SIGNING_SECRET=dev-only-change-me
FILE_LINK_TTL_SECONDS=600

# --- Deletion: data is invisible at once, physically purged after this delay (agreed retention)
PURGE_DELAY_SECONDS=0

# --- Demo topic ------------------------------------------------------------------
DEMO_ENABLED=true
DEMO_FREE_QUESTIONS=3

# --- Worker ------------------------------------------------------------------------
WORKER_CONCURRENCY=4
WORKER_POLL_SECONDS=1
WORKER_LEASE_SECONDS=1200
WORKER_MAX_ATTEMPTS=3

# --- Paywall presentation (RU checkout): price/period per productId. Display only — credits come
# from PRODUCTS; App Store prices come from StoreKit on the device.
PLAN_DISPLAY={"week_6.99_nottrial":{"price":"599","currency":"RUB","period":"P1W"},"yearly_49.99_nottrial":{"price":"3990","currency":"RUB","period":"P1Y"},"100_Tokens_9.99":{"price":"790","currency":"RUB"},"250_Tokens_19.99":{"price":"1590","currency":"RUB"},"500_Tokens_34.99":{"price":"2790","currency":"RUB"},"1000_Tokens_59.99":{"price":"4790","currency":"RUB"}}
SUPPORT_URL=
PRIVACY_URL=
TERMS_URL=
