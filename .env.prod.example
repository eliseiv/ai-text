# =============================================================================
# PRODUCTION env template — shared server + EXTERNAL Traefik.
# Copy to `.env` ON THE SERVER in /opt/<instance> and fill from the secret manager.
# NEVER commit the real `.env` (gitignored). This `.example` holds PLACEHOLDERS ONLY.
#
# Generate high-entropy secrets with:  openssl rand -base64 32   (or -hex 32)
# Loaded by docker-compose.prod.yml via `env_file: .env` (api + migrate). The image is built ON
# THE SERVER from sources, so there is no IMAGE/IMAGE_TAG here.
#
# Before the first `up`, walk the prod-readiness checklist.
# =============================================================================

# --- Service / instance identity ---------------------------------------------
# Name of THIS service: OpenAPI title, `service` label in logs/metrics. PUBLIC config.
SERVICE_NAME=<my-service>
# Optional human-readable OpenAPI title. Empty -> title = SERVICE_NAME.
SERVICE_TITLE=
# Application version: OpenAPI `version` + the `version` label of logs/metrics.
SERVICE_VERSION=0.1.0
# Instance domain: Traefik Host router + ACME cert, and absolute URLs built by the app.
# Its A-record MUST point at the server BEFORE the first `up` (Traefik's ACME challenge).
# PUBLIC config, not a secret.
SERVICE_DOMAIN=<my-service.example.com>
# docker-compose project name = instance prefix. Substituted into the image tags
# (<proj>-backend:prod) and the Traefik router/service names. Deploy with `-p <proj>` so the
# containers/volumes/default-network are isolated per instance. PUBLIC config.
COMPOSE_PROJECT_NAME=<my-service>
# ACME cert-resolver name configured in the SHARED Traefik (/opt/edge) by the server owner.
TRAEFIK_CERTRESOLVER=le
# Name of the shared docker network Traefik watches (external). On the gelnora server: web2
# (`web` is full). Consumed by docker-compose.prod.yml only.
TRAEFIK_NETWORK=web
ENVIRONMENT=prod
LOG_LEVEL=INFO
# Do NOT expose the API schema publicly.
DOCS_ENABLED=false

# --- Storage -----------------------------------------------------------------
# In-compose service names (internal `default` network). The creds MUST match POSTGRES_* below.
# CLONE NOTE: every instance uses its OWN database and its OWN fresh password — never reuse a
# sibling instance's DB or credentials (volumes are isolated per project name).
DATABASE_URL=postgresql+asyncpg://<db_user>:<db_password>@postgres:5432/<db_name>
REDIS_URL=redis://redis:6379/0
POSTGRES_USER=<db_user>
# SECRET — high-entropy, from the secret manager.
POSTGRES_PASSWORD=<db_password>
POSTGRES_DB=<db_name>
# Effective conns ~= (DB_POOL_SIZE + DB_MAX_OVERFLOW) * gunicorn_workers(4) * replicas(1)
# = (10 + 5) * 4 * 1 = 60 < Postgres max_connections (100). Recompute if you scale.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# --- Auth / JWT (embedded RS256 issuer) --------------------------------------
# Generate the keypair ON THE SERVER, per instance (never in the repo, never in the image):
#   mkdir -p /opt/<instance>/.secrets
#   openssl genrsa -out /opt/<instance>/.secrets/jwt_private.pem 2048
#   openssl rsa -in /opt/<instance>/.secrets/jwt_private.pem -pubout \
#        -out /opt/<instance>/.secrets/jwt_public.pem
#   chmod 600 /opt/<instance>/.secrets/jwt_private.pem
# `.secrets/` is bind-mounted read-only into the api container by docker-compose.prod.yml.
# Without a private key /v1/auth/* returns 503.
JWT_ISSUER=https://<my-service.example.com>
JWT_AUDIENCE=<my-service>
JWT_KID=key-1
JWT_PRIVATE_KEY_PATH=/app/.secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/app/.secrets/jwt_public.pem
# Inline PEM alternative — leave EMPTY when using *_PATH (which takes priority).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_JWKS_URL=
JWT_JWKS_CACHE_TTL=300
AUTH_ACCESS_TTL_SECONDS=3600
AUTH_REFRESH_TTL_SECONDS=2592000
AUTH_RATE_LIMIT_PER_IP=10
AUTH_JWKS_ENABLED=true

# --- Sign in with Apple ------------------------------------------------------
APPLE_OIDC_ISSUER=https://appleid.apple.com
APPLE_JWKS_URL=https://appleid.apple.com/auth/keys
# Expected `aud` of the Apple identity token = the REAL bundle id of the app. Empty -> falls back
# to APPSTORE_BUNDLE_ID; if BOTH are empty, POST /v1/auth/apple returns 503. Set one of them.
APPLE_AUDIENCE=<com.example.app>
# MUST be false in prod (fail-closed: an HS256 token outside test-mode -> 401).
APPLE_TEST_MODE=false
# MUST stay EMPTY in prod.
APPLE_TEST_SECRET=

# --- Apple StoreKit ----------------------------------------------------------
APPSTORE_ENVIRONMENT=Production
APPSTORE_BUNDLE_ID=<com.example.app>
# The IN-CONTAINER path is PINNED by docker-compose.prod.yml (`environment:` overrides this file)
# to /etc/appstore-certs, which bind-mounts ./certs/appstore read-only. To enable REAL JWS
# verification, drop the public Apple root CA into /opt/<instance>/certs/appstore and recreate api:
#   curl -fsSL -o certs/appstore/AppleRootCA-G3.cer https://www.apple.com/appleca/AppleRootCA-G3.cer
#   docker compose -p <inst> -f docker-compose.prod.yml --env-file .env up -d --no-build api
# An EMPTY dir -> no roots -> StoreKit verification is fail-closed (422). The container still starts.
APPSTORE_ROOT_CERT_DIR=/etc/appstore-certs
# MUST be false in prod; the secret MUST stay empty.
STOREKIT_TEST_MODE=false
STOREKIT_TEST_SECRET=

# --- Billing — common --------------------------------------------------------
# THE single product map: the ONLY source of the credit amount (BR-8) and the per-product channel
# allowlist. It MUST cover EVERY productId really configured in App Store Connect / Adapty / the
# aggregator — a product outside this map is REJECTED (payment succeeds, 0 credits granted,
# alert PaymentRejected). There is NO fallback grant in any channel, by design.
# `period` (ISO-8601: P1W / P1M / P1Y) is REQUIRED for a subscription sold via cloudpayments:
# the RU channel reports a payment, not an expiry, so access lasts exactly one period.
PRODUCTS={"week_6.99_nottrial":{"kind":"subscription","credits":100,"channels":["apple_storekit","adapty","cloudpayments"],"title":"Неделя","period":"P1W"},"yearly_49.99_nottrial":{"kind":"subscription","credits":800,"channels":["apple_storekit","adapty","cloudpayments"],"title":"Год","period":"P1Y"},"100_Tokens_9.99":{"kind":"tokens","credits":100,"channels":["apple_storekit","adapty","cloudpayments"],"title":"100 кредитов"},"250_Tokens_19.99":{"kind":"tokens","credits":250,"channels":["apple_storekit","adapty","cloudpayments"],"title":"250 кредитов"},"500_Tokens_34.99":{"kind":"tokens","credits":500,"channels":["apple_storekit","adapty","cloudpayments"],"title":"500 кредитов"},"1000_Tokens_59.99":{"kind":"tokens","credits":1000,"channels":["apple_storekit","adapty","cloudpayments"],"title":"1000 кредитов"}}
# Default credits of the ADMIN subscription grant ONLY. Not used by any payment channel.
SUBSCRIPTION_CREDITS_PER_PERIOD=1000
TRIAL_ENABLED=true

# --- Billing — Adapty --------------------------------------------------------
# SECRET, high-entropy (>= 32 bytes), PER-INSTANCE, isolated from every other secret. Empty ->
# the endpoint returns 500. The SAME value must be set as the Authorization: Bearer header of the
# webhook in the Adapty dashboard for THIS instance's app:
#   https://<SERVICE_DOMAIN>/v1/billing/adapty/webhook
# Provision:  openssl rand -hex 32  ->  /opt/<instance>/.env  ->  restart api  ->  Adapty UI.
# Never share one secret across instances.
ADAPTY_WEBHOOK_SECRET=<openssl rand -hex 32; must match the Adapty dashboard>

# --- Billing — CloudPayments / broadapps (RU) --------------------------------
# Leave the whole block empty if the RU channel is not used (the channel then stays inactive).
CLOUDPAYMENTS_API_BASE=<https://pay.broadapps.dev/api/v1>
CLOUDPAYMENTS_APP_ID=<aggregator_app_id>
# SECRET. Bearer of OUR outgoing calls (checkout + verify) and the channel activation gate:
# empty -> webhook 500, checkout 503.
CLOUDPAYMENTS_API_TOKEN=<aggregator_api_token>
# LEGACY, optional — no longer gates anything (observability field only).
CLOUDPAYMENTS_WEBHOOK_TOKEN=
CLOUDPAYMENTS_PAID_STATUSES=succeeded
# Aggregator statuses meaning "refunded" (CSV). A refund callback is only a trigger: the
# refund is confirmed through verify, and only payments we credited are reversed.
CLOUDPAYMENTS_REFUNDED_STATUSES=refunded
# Reconciliation only credits payments with paid_at >= now - N hours.
CLOUDPAYMENTS_PAYMENT_FRESHNESS_HOURS=72
# Per-IP limit of the PUBLIC webhook (anti-amplification of the outgoing verify calls).
CLOUDPAYMENTS_WEBHOOK_RATE_LIMIT_PER_IP=120

# --- Generation & pricing ----------------------------------------------------
# `echo` is the built-in EchoProvider. A domain registers its own provider via
# DomainRegistry.generation_provider and names it here.
GENERATION_PROVIDER=echo
# Summaries of long topics make several model calls: keep this generous.
GENERATION_TIMEOUT_SECONDS=600
# Must hold a full answer/summary (idempotent replay after a worker crash reads it back).
GENERATION_META_MAX_BYTES=262144
GENERATION_MAX_INFLIGHT_PER_USER=3
# The domain registers its own pricing (ANSWER_CREDITS / SUMMARY_CREDITS below).
PRICING_MODE=flat
PRICING_FLAT_CREDITS=1
PRICING_UNITS={}
PRICING_TOKEN_WEIGHTS={}
PRICING_TOKEN_DIVISOR=1000
# Anti-tamper ceiling on the price of ONE generation (BR-9). Calibrate against the real tariff.
PRICING_MAX_CREDITS_PER_GENERATION=100

# --- Admin -------------------------------------------------------------------
# SECRET, isolated, high-entropy. Empty -> the admin API always returns 401.
ADMIN_API_SECRET=<openssl rand -base64 32>
# SECRET. Previous secret, valid during the rotation grace period; empty outside rotation.
ADMIN_API_SECRET_PREV=
ADMIN_RATE_LIMIT_PER_MIN=10

# --- Gateway / limits --------------------------------------------------------
SIZE_LIMIT_BODY=524288
RATE_LIMIT_PER_USER=60
RATE_LIMIT_PER_IP=120
# POST /v1/generate, per user, per RATE_LIMIT_WINDOW_SECONDS.
RATE_LIMIT_GENERATION_PER_USER=20
# Sliding-window width of every Redis limiter. 60 => the caps above read as "per minute".
RATE_LIMIT_WINDOW_SECONDS=60
# MUST-CONFIGURE: the subnet of the docker network `web`, so per-IP rate limiting sees the real
# client IP from Traefik's X-Forwarded-For instead of Traefik's own IP (which is identical for
# every client and makes the per-IP limit effectively global = broken). Find it ON THE SERVER:
#   docker network inspect $TRAEFIK_NETWORK  ->  .[0].IPAM.Config[].Subnet
TRUSTED_PROXY_IPS=<web-network-subnet-cidr, e.g. 172.18.0.0/16>
TRUSTED_PROXY_HOP_COUNT=1

# --- Observability -----------------------------------------------------------
# SECRET: if set, GET /metrics requires X-Scrape-Token == this value (otherwise 403). If you leave
# it empty, /metrics MUST be closed by a network policy instead.
METRICS_SCRAPE_TOKEN=<openssl rand -base64 32>
OTEL_EXPORTER_OTLP_ENDPOINT=

# =============================================================================
# DOMAIN — sources, AI summaries, Q&A with citations (DomainSettings)
# =============================================================================
# --- LLM: OpenAI (server-side only; the iOS app never holds a model key) --------
# openai | fake   (fake = deterministic offline model for local runs/tests)
LLM_PROVIDER=openai
# SECRET. Primary key and a backup key of a SECOND account (takes over on auth/quota errors).
OPENAI_API_KEY=
OPENAI_API_KEY_BACKUP=
# Optional gateway in front of the API. Empty -> https://api.openai.com/v1.
OPENAI_BASE_URL=
# Optional (the service runs on a foreign server — leave EMPTY). SECRET if set: comma-separated
# proxies tried in order on connection errors, e.g. socks5://user:pass@host:1080
OPENAI_PROXY_URLS=
# Answers and summaries. Summaries may use a cheaper model (empty = OPENAI_MODEL).
OPENAI_MODEL=gpt-5.1
OPENAI_SUMMARY_MODEL=
# «Does the quote support the claim?» — a yes/no check, a small model is enough.
OPENAI_CHECK_MODEL=gpt-5-mini
# gpt-5*/o-series only: minimal | low | medium | high  (gpt-5.1 also: none)
OPENAI_REASONING_EFFORT=low
OPENAI_CHECK_REASONING_EFFORT=minimal
# Includes reasoning tokens.
OPENAI_MAX_OUTPUT_TOKENS=16000
OPENAI_TIMEOUT_SECONDS=180
OPENAI_MAX_RETRIES=2
# Second pass: does every quote actually support its claim? Unsupported claims are dropped.
CITATION_SUPPORT_CHECK=true

# --- Prices in credits (rationale: docs/pricing.md) ------------------------------
ANSWER_CREDITS=1
# Summary: base price while the topic fits one pass (SUMMARY_SINGLE_PASS_CHARS), plus this much
# for every extra part of SUMMARY_BATCH_CHARS. Max = 3 + 2 * (SUMMARY_MAX_BATCHES - 1) = 17.
SUMMARY_CREDITS=3
SUMMARY_CREDITS_PER_EXTRA_PART=2

# --- Context budgets -----------------------------------------------------------
ANSWER_CONTEXT_CHARS=100000
ANSWER_HISTORY_TURNS=6
QUESTION_MAX_CHARS=2000
SUMMARY_SINGLE_PASS_CHARS=150000
SUMMARY_BATCH_CHARS=120000
SUMMARY_MAX_BATCHES=8
CHUNK_TARGET_CHARS=1500

# --- Import limits (served as is by GET /v1/limits) ----------------------------
PDF_MAX_BYTES=31457280
PDF_MAX_PAGES=300
PDF_MIN_CHARS_PER_PAGE=20
PDF_MIN_TEXT_PAGE_RATIO=0.3
TEXT_MIN_CHARS=50
TEXT_MAX_CHARS=300000
WEB_MAX_BYTES=5242880
WEB_TIMEOUT_SECONDS=15
WEB_MAX_REDIRECTS=5
TOPIC_MAX_SOURCES=20
USER_MAX_TOPICS=100
USER_STORAGE_MAX_BYTES=1073741824

# --- Files -----------------------------------------------------------------------
# docker-compose overrides this with the shared volume /data/files.
FILES_DIR=/data/files
# SECRET. HMAC key of temporary file links (openssl rand -hex 32). Empty -> links answer 503.
FILES_SIGNING_SECRET=<openssl rand -hex 32>
FILE_LINK_TTL_SECONDS=600

# --- Deletion: data is invisible at once, physically purged after this delay (agreed retention)
PURGE_DELAY_SECONDS=86400

# --- Demo topic ------------------------------------------------------------------
DEMO_ENABLED=true
DEMO_FREE_QUESTIONS=3

# --- Worker ------------------------------------------------------------------------
WORKER_CONCURRENCY=4
WORKER_POLL_SECONDS=1
WORKER_LEASE_SECONDS=1200
WORKER_MAX_ATTEMPTS=3

# --- Paywall presentation (RU checkout): price/period per productId. Display only — credits come
# from PRODUCTS; App Store prices come from StoreKit on the device.
PLAN_DISPLAY={"week_6.99_nottrial":{"price":"599","currency":"RUB","period":"P1W"},"yearly_49.99_nottrial":{"price":"3990","currency":"RUB","period":"P1Y"},"100_Tokens_9.99":{"price":"790","currency":"RUB"},"250_Tokens_19.99":{"price":"1590","currency":"RUB"},"500_Tokens_34.99":{"price":"2790","currency":"RUB"},"1000_Tokens_59.99":{"price":"4790","currency":"RUB"}}
SUPPORT_URL=
PRIVACY_URL=
TERMS_URL=
