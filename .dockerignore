# Keep the build context minimal and free of secrets / local cruft.
.env
.env.*
!.env.example
# Defense-in-depth: keep all local secrets out of the build context regardless of the
# whitelist-COPY in the Dockerfile (private JWT key, any cert).
.secrets/
certs/
*.pem
*.key
*.cer
*.der
*.crt
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
dist/
build/
*.egg-info/

# Not needed inside the image.
tests/
docs/
.git/
.github/
infra/
docker-compose*.yml
*.md
